    <% if(typeof errors !== 'undefined' && errors && errors.length > 0) { %>
                <div class="rounded-lg bg-red-100 p-4 text-sm text-red-700">
                  <ul>
                    <% errors.forEach((error) => { %>
                      <li><%= error %></li>
                    <% }); %>
                  </ul>
                </div>
              <% } %>