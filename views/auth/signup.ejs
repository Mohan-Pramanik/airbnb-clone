<%- include('../partials/head') %>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <%- include('../partials/nav') %>

    <main class="min-h-screen bg-gradient-to-br from-rose-50 via-white to-orange-50 px-4 py-10 sm:px-6 lg:py-16">
      <section class="mx-auto grid max-w-5xl overflow-hidden rounded-3xl bg-white shadow-xl shadow-slate-200/70 ring-1 ring-slate-200 lg:grid-cols-2">
        <div class="relative hidden overflow-hidden bg-gradient-to-br from-rose-500 via-red-500 to-orange-400 p-10 text-white lg:flex lg:flex-col lg:justify-between xl:p-14">
          <div class="absolute -right-20 -top-16 h-72 w-72 rounded-full border-[36px] border-white/10"></div>
          <div class="absolute -bottom-28 -left-24 h-80 w-80 rounded-full bg-white/10"></div>

          <div class="relative">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80">A place to belong</p>
            <h1 class="mt-6 max-w-sm text-4xl font-bold leading-tight xl:text-5xl">Your next stay starts here.</h1>
            <p class="mt-5 max-w-sm text-base leading-7 text-white/85">
              Create an account to discover welcoming places and make every trip feel a little more like home.
            </p>
          </div>

          <div class="relative mt-12 rounded-2xl border border-white/20 bg-white/10 p-5 backdrop-blur-sm">
            <p class="text-lg font-medium">“The world feels closer when you have a place to call your own.”</p>
            <p class="mt-3 text-sm text-white/75">Make yourself at home, wherever you go.</p>
          </div>
        </div>

        <div class="px-6 py-8 sm:px-10 sm:py-12 xl:px-14">
          <div class="mx-auto max-w-md">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-rose-600">Get started</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Create your account</h2>
            <p class="mt-2 text-sm leading-6 text-slate-500">It only takes a minute. Let’s get you set up.</p>

            <form action="/signup" method="POST" class="mt-8 space-y-5">

              <!-- error handling for the signup form -->

              <%- include('../partials/error') %>


              <!-- // firstName Block -->
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="firstName" class="mb-2 block text-sm font-medium text-slate-700">First name</label>
                  <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    value="<%= oldInputs.firstName ? oldInputs.firstName : '' %>"
                    autocomplete="given-name"
                    placeholder="Alex"
                    class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                    required>
                </div>
                <div>
                  <label for="lastName" class="mb-2 block text-sm font-medium text-slate-700">Last name</label>
                  <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    value="<%= oldInputs.lastName ? oldInputs.lastName : '' %>"
                    autocomplete="family-name"
                    placeholder="Morgan"
                    class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100">
                </div>
              </div>

              <div>
                <label for="email" class="mb-2 block text-sm font-medium text-slate-700">Email address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  value="<%= oldInputs.email ? oldInputs.email : '' %>"
                  autocomplete="email"
                  placeholder="you@example.com"
                  class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                  required>
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="password" class="mb-2 block text-sm font-medium text-slate-700">Password</label>
                  <input
                    type="password"
                    id="password"
                    name="password"
                    autocomplete="new-password"
                    placeholder="Create a password"
                    class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                    required>
                </div>
                <div>
                  <label for="confirmPassword" class="mb-2 block text-sm font-medium text-slate-700">Confirm password</label>
                  <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    autocomplete="new-password"
                    placeholder="Enter it again"
                    class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                    required>
                </div>
              </div>

              <div>
                <label for="userType" class="mb-2 block text-sm font-medium text-slate-700">I’m here as a</label>
                <select
                  name="userType"
                  id="userType"
                  class="block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"
                  required>
                  
                  <option value="" disabled <%= oldInputs.userType ? '' : 'selected' %>>Select your role</option>
                  <option value="guest" <%= oldInputs.userType === 'guest' ? 'selected' : '' %>>Guest</option>
                  <option value="host" <%= oldInputs.userType === 'host' ? 'selected' : '' %>>Host</option>
                </select>
              </div>

              <label for="termAccept" class="flex cursor-pointer items-start gap-3 text-sm leading-6 text-slate-600">
                <input
                  type="checkbox"
                  value="termAccept"
                  name="termAccept"
                  id="termAccept"
                  class="mt-1 h-4 w-4 rounded border-slate-300 accent-rose-500 focus:ring-rose-500">
                <span>I accept the terms and conditions.</span>
              </label>

              <button
                type="submit"
                class="w-full rounded-xl bg-rose-500 px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-rose-500/20 transition hover:bg-rose-600 focus:outline-none focus:ring-4 focus:ring-rose-200 active:scale-[0.99]">
                Create account
              </button>
            </form>

            <p class="mt-7 text-center text-sm text-slate-500">
              Already have an account?
              <a href="/login" class="font-semibold text-rose-600 transition hover:text-rose-700 hover:underline">Sign in</a>
            </p>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
